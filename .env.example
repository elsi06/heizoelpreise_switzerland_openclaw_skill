# Heating Oil Price Skill Configuration
# Set your local ZIP code (e.g., 8000 for Zurich)
ZIP_CODE=8000

# Amount in liters (e.g., 3000)
AMOUNT=3000

# Telegram notification (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Cron schedule (default: every day at 08:00)
CRON_SCHEDULE=0 8 * * *

# Log level (info, debug, error)
LOG_LEVEL=info
